# Booking API (writes go through here — keeps the anti-double-booking transaction)
VITE_API_URL=http://localhost:4000

# Firebase web config — enables TRUE realtime reads (onSnapshot).
# Get these from Firebase Console → Project settings → General → Your apps → Web app.
# If left blank, the app falls back to API polling.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=online-naile-service.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=online-naile-service
VITE_FIREBASE_STORAGE_BUCKET=online-naile-service.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
