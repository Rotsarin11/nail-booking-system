/**
 * Take Care Nail — Booking API (Express + MySQL/MariaDB)
 * ------------------------------------------------------------------
 * The authoritative booking service. Reads services/staff/bookings from
 * MySQL, computes slot availability, and creates bookings inside a SQL
 * transaction that re-locks and re-checks the slot — so two customers
 * can never grab the same time with the same staff (คิวชน).
 *
 *   npm install
 *   npm run start        (or: npm run dev)
 *
 * Requires a MySQL/MariaDB database created from schema/nail_booking_schema.sql
 * plus schema_addendum_mysql_migration.sql — see .env.example for connection config.
 */
require('dotenv').config()
const express = require('express')
const cors = require('cors')
const repo = require('./lib/repo')
const slots = require('./lib/slots')

const app = express()
app.use(cors())
app.use(express.json())

const PORT = process.env.PORT || 4000
const todayKey = () => {
  const d = new Date()
  const p = (n) => String(n).padStart(2, '0')
  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`
}
const wrap = (fn) => (req, res) => fn(req, res).catch((e) => {
  console.error(req.method, req.path, '→', e.message)
  res.status(e.status || 500).json({ error: e.message || 'internal error' })
})

// ── Health ──────────────────────────────────────────────────────────
app.get('/api/health', wrap(async (_req, res) => {
  res.json({ ok: true, db: process.env.DB_NAME || 'nail_booking', time: new Date().toISOString() })
}))

// ── Catalog reads ───────────────────────────────────────────────────
app.get('/api/services', wrap(async (_req, res) => {
  const list = (await repo.getServices()).filter((s) => s.isActive !== false)
  res.json(list)
}))
app.get('/api/staff', wrap(async (_req, res) => {
  res.json(await repo.getStaff())
}))
app.get('/api/shop-closures', wrap(async (_req, res) => {
  res.json(await repo.getClosures())
}))

// ── Availability ────────────────────────────────────────────────────
// GET /api/availability?date=YYYY-MM-DD&serviceIds=a,b&staffId=any|<id>
app.get('/api/availability', wrap(async (req, res) => {
  const { date, staffId = 'any' } = req.query
  const serviceIds = String(req.query.serviceIds || '').split(',').filter(Boolean)
  if (!date || serviceIds.length === 0) {
    return res.status(400).json({ error: 'ต้องระบุ date และ serviceIds' })
  }
  const [services, staff, bookings, closures] = await Promise.all([
    repo.getServices(), repo.getStaff(), repo.getBookings(), repo.getClosures(),
  ])
  const sMap = Object.fromEntries(services.map((s) => [s.id, s]))
  const block = slots.blockMinutes(serviceIds, sMap)
  const eligible = slots.qualifiedStaff(staff, serviceIds)

  let result
  if (staffId === 'any') {
    result = slots.slotsForAny(eligible, date, block, bookings, closures, todayKey())
  } else {
    const st = staff.find((s) => s.id === staffId)
    result = slots.slotsForStaff(st, date, block, bookings, closures, todayKey())
  }
  res.json({ block, slots: result })
}))

// ── Bookings list ───────────────────────────────────────────────────
// GET /api/bookings?userId=<id>   → a customer's bookings
// GET /api/bookings?scope=admin   → all bookings (owner dashboard)
app.get('/api/bookings', wrap(async (req, res) => {
  const { userId, scope } = req.query
  let list = await repo.getBookings()
  if (scope !== 'admin') {
    if (!userId) return res.status(400).json({ error: 'ต้องระบุ userId หรือ scope=admin' })
    const numericId = await repo.findUserNumericId(userId)
    list = numericId == null ? [] : list.filter((b) => b.userId === String(numericId))
  }
  list.sort((a, b) => (b.bookingDate + b.startTime).localeCompare(a.bookingDate + a.startTime))
  res.json(list)
}))

app.get('/api/bookings/:id', wrap(async (req, res) => {
  const booking = await repo.getBookingById(req.params.id)
  if (!booking) return res.status(404).json({ error: 'ไม่พบการจอง' })
  res.json(booking)
}))

// ── Create booking (transaction-guarded) ────────────────────────────
// POST /api/bookings { userId, userName, phone?, serviceIds[], staffId, date, time, note? }
app.post('/api/bookings', wrap(async (req, res) => {
  const { userId, userName, phone, serviceIds, staffId = 'any', date, time, note = '' } = req.body || {}
  if (!userId || !Array.isArray(serviceIds) || !serviceIds.length || !date || !time) {
    return res.status(400).json({ error: 'ข้อมูลไม่ครบ (userId, serviceIds, date, time)' })
  }
  const created = await repo.createBookingTx({ userId, userName, phone, serviceIds, staffId, date, time, note })
  res.status(201).json(created)
}))

// ── Update status (admin) ───────────────────────────────────────────
// PATCH /api/bookings/:id { status, result? }
app.patch('/api/bookings/:id', wrap(async (req, res) => {
  const { status, result, cancelReason } = req.body || {}
  const allowed = ['pending', 'confirmed', 'completed', 'cancelled', 'no_show']
  if (!allowed.includes(status)) return res.status(400).json({ error: 'สถานะไม่ถูกต้อง' })
  // Cancelling must carry a reason (international best practice: auditable).
  if (status === 'cancelled' && !String(cancelReason || '').trim()) {
    return res.status(400).json({ error: 'ต้องระบุเหตุผลในการยกเลิก' })
  }
  const existing = await repo.getBookingById(req.params.id)
  if (!existing) return res.status(404).json({ error: 'ไม่พบการจอง' })
  const updated = await repo.updateBookingStatus(req.params.id, { status, result, cancelReason })
  res.json(updated)
}))

// ── Cancel (customer) ───────────────────────────────────────────────
app.post('/api/bookings/:id/cancel', wrap(async (req, res) => {
  const existing = await repo.getBookingById(req.params.id)
  if (!existing) return res.status(404).json({ error: 'ไม่พบการจอง' })
  const updated = await repo.cancelBookingByCustomer(req.params.id, req.body?.cancelReason)
  res.json(updated)
}))

// ════════════════════════════════════════════════════════════════════
//  ADMIN MANAGEMENT — CRUD for the catalog tables
// ════════════════════════════════════════════════════════════════════
const num = (v, d = 0) => (v === '' || v == null || isNaN(Number(v)) ? d : Number(v))

// ── Services ────────────────────────────────────────────────────────
app.post('/api/services', wrap(async (req, res) => {
  const b = req.body || {}
  if (!b.name) return res.status(400).json({ error: 'ต้องระบุชื่อบริการ' })
  const created = await repo.createService({
    name: b.name, category: b.category, description: b.description,
    durationMin: num(b.durationMin, 30), bufferMin: num(b.bufferMin, 0), price: num(b.price, 0),
    isActive: b.isActive !== false,
  })
  res.status(201).json(created)
}))
app.patch('/api/services/:id', wrap(async (req, res) => {
  const b = req.body || {}
  const patch = {}
  if (b.name !== undefined) patch.name = b.name
  if (b.category !== undefined) patch.category = b.category
  if (b.description !== undefined) patch.description = b.description
  if (b.durationMin != null) patch.durationMin = num(b.durationMin)
  if (b.bufferMin != null) patch.bufferMin = num(b.bufferMin)
  if (b.price != null) patch.price = num(b.price)
  if (b.isActive !== undefined) patch.isActive = b.isActive
  const updated = await repo.updateService(req.params.id, patch)
  if (!updated) return res.status(404).json({ error: 'ไม่พบบริการ' })
  res.json(updated)
}))
app.delete('/api/services/:id', wrap(async (req, res) => {
  await repo.deleteService(req.params.id)
  res.json({ ok: true })
}))

// ── Staff ───────────────────────────────────────────────────────────
app.post('/api/staff', wrap(async (req, res) => {
  const b = req.body || {}
  if (!b.fullName) return res.status(400).json({ error: 'ต้องระบุชื่อช่าง' })
  const id = await repo.createStaff(b)
  const all = await repo.getStaff()
  res.status(201).json(all.find((s) => s.id === String(id)))
}))
app.patch('/api/staff/:id', wrap(async (req, res) => {
  await repo.updateStaff(req.params.id, req.body || {})
  const all = await repo.getStaff()
  res.json(all.find((s) => s.id === String(req.params.id)))
}))
app.delete('/api/staff/:id', wrap(async (req, res) => {
  await repo.deleteStaff(req.params.id)
  res.json({ ok: true })
}))

// ── Shop closures (holidays + staff leave) ──────────────────────────
app.post('/api/shop-closures', wrap(async (req, res) => {
  const b = req.body || {}
  if (!b.closureDate) return res.status(400).json({ error: 'ต้องระบุวันที่' })
  const created = await repo.createClosure(b)
  res.status(201).json(created)
}))
app.delete('/api/shop-closures/:id', wrap(async (req, res) => {
  await repo.deleteClosure(req.params.id)
  res.json({ ok: true })
}))

// ── Customers (users with role=customer + derived stats) ────────────
app.get('/api/customers', wrap(async (_req, res) => {
  res.json(await repo.getCustomers())
}))

// ── Shop settings (single row) ──────────────────────────────────────
app.get('/api/settings', wrap(async (_req, res) => {
  res.json(await repo.getSettings())
}))
app.put('/api/settings', wrap(async (req, res) => {
  res.json(await repo.saveSettings(req.body || {}))
}))

app.listen(PORT, () => {
  console.log(`✅ Booking API (MySQL) listening on http://localhost:${PORT}`)
})
