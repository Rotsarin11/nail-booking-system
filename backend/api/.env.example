# Booking API configuration
PORT=4000

# MySQL / MariaDB connection (local dev, or a cloud MySQL provider —
# Railway, Clever Cloud, Aiven, AWS RDS, Google Cloud SQL, etc.)
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=nail_booking

# LINE Login channel ID (LINE Developers Console → your channel → Basic
# settings → Channel ID). Required for /api/auth/line to accept LIFF
# access tokens — without it, that endpoint always rejects (fails closed),
# and the customer app quietly falls back to the mock profile.
LINE_LOGIN_CHANNEL_ID=
