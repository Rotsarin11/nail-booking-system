rules_version = '2';
// กฎความปลอดภัย Firestore — ระบบจองคิวทำเล็บออนไลน์
// หลักการ:
//  - เว็บแอดมิน + backend ใช้ Admin SDK (bypass rules อยู่แล้ว)
//  - ถ้าฝั่งลูกค้า (LIFF) เขียน Firestore ตรง ควรจำกัดสิทธิ์ตามนี้
//  - แนะนำ (ปลอดภัยสุด): ให้ "การจอง" ผ่าน backend Express เท่านั้น เพื่อคุม
//    การกันคิวชน (transaction) — แล้วปิด write ฝั่ง client ของ bookings
service cloud.firestore {
  match /databases/{database}/documents {

    // อ่านบริการ/ช่างได้ (ใช้แสดงเมนูจอง) แต่แก้ไม่ได้จาก client
    match /services/{id} {
      allow read: if true;
      allow write: if false;   // แก้ผ่าน backend/แอดมินเท่านั้น
    }
    match /staff/{id} {
      allow read: if true;
      allow write: if false;
    }

    // การจอง: ปิด write จาก client ทั้งหมด -> บังคับให้ผ่าน backend (transaction กันคิวชน)
    match /bookings/{id} {
      allow read: if true;     // (จะจำกัดเป็นเจ้าของก็ได้ถ้ามี Firebase Auth)
      allow write: if false;
    }

    // users / notifications / shopClosures: จัดการผ่าน backend เท่านั้น
    match /users/{id}         { allow read, write: if false; }
    match /notifications/{id} { allow read, write: if false; }
    match /shopClosures/{id}  { allow read: if true; allow write: if false; }
  }
}
